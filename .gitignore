# Deny everything by default; this directory also holds data, models and job logs
*
!*/

# Code and config
!*.py
!*.sh
!*.conf
!*.yaml
!*.yml
!.gitignore
!README.md
!requirements.txt
!environment.yml
!assets/**

# Data, outputs and caches
*.jsonl
*.json
*.csv
*.txt
*.out
*.err
*.pyc
__pycache__/
Miniconda3-*.sh
huggingface/
wandb/
unsloth_compiled_cache/
_unsloth_sentencepiece_temp/
tokenizer_tmp/
models*/
outputs/
seed-*/
old_responses/

# requirements.txt is re-allowed after *.txt
!requirements.txt
